    {
      "name": "Flight Service",
      "description": "Flight search microservice. Returns available flights matching origin, destination, and date.",
      "item": [
        {
          "name": "Search Flights",
          "request": {
            "description": "Search for flights between two airports on a given date. Origin and destination are IATA airport codes. Date must be in YYYY-MM-DD format.",
            "method": "GET",
            "header": [
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              }
            ],
            "url": {
              "raw": "{{flightServiceUrl}}/api/v1/flights/search?origin=BLR&destination=NRT&departureDate=2026-07-15",
              "host": ["{{flightServiceUrl}}"],
              "path": ["api", "v1", "flights", "search"],
              "query": [
                {
                  "key": "origin",
                  "value": "BLR",
                  "description": "IATA departure airport code (e.g. BLR, JFK, LHR)"
                },
                {
                  "key": "destination",
                  "value": "NRT",
                  "description": "IATA arrival airport code (e.g. NRT, DXB, CDG)"
                },
                {
                  "key": "departureDate",
                  "value": "2026-07-15",
                  "description": "Travel date in YYYY-MM-DD format"
                }
              ]
            }
          },
          "response": [
            {
              "name": "Success — Flights Found",
              "status": "OK",
              "code": 200,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "X-Trace-Id",
                  "value": "{{traceId}}"
                }
              ],
              "body": "{\n  \"flights\": [\n    {\n      \"airline\": \"Air France\",\n      \"flightNumber\": \"AF123\",\n      \"origin\": \"BLR\",\n      \"destination\": \"NRT\",\n      \"departureDate\": \"2026-07-15\",\n      \"price\": 450.00,\n      \"currency\": \"USD\"\n    },\n    {\n      \"airline\": \"Lufthansa\",\n      \"flightNumber\": \"LH456\",\n      \"origin\": \"BLR\",\n      \"destination\": \"NRT\",\n      \"departureDate\": \"2026-07-15\",\n      \"price\": 520.00,\n      \"currency\": \"USD\"\n    },\n    {\n      \"airline\": \"Delta Air Lines\",\n      \"flightNumber\": \"DL789\",\n      \"origin\": \"BLR\",\n      \"destination\": \"NRT\",\n      \"departureDate\": \"2026-07-15\",\n      \"price\": 380.00,\n      \"currency\": \"USD\"\n    }\n  ]\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", () => {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Response body exists\", () => {",
                  "    pm.response.to.have.body();",
                  "});",
                  "pm.test(\"X-Trace-Id response header exists\", () => {",
                  "    pm.response.to.have.header(\"X-Trace-Id\");",
                  "});",
                  "pm.test(\"flights array is present\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.flights).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
