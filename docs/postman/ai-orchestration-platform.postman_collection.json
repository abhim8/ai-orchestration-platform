              "}",
              "if (!pm.collectionVariables.get(\"conversationId\")) {",
              "    pm.collectionVariables.set(\"conversationId\", pm.variables.replaceIn(\"{{$uuid}}\"));",
              "}"
            ],
            "type": "text/javascript"
          }
        }
      ]
