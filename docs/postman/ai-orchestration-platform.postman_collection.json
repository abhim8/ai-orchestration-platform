        {
          "name": "Chat — Validation Error",
          "request": {
            "description": "Sends a blank message to demonstrate the structured error response returned by GlobalExceptionHandler when MethodArgumentNotValidException is thrown.",
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Trace-Id",
                "value": "{{traceId}}"
              },
              {
                "key": "X-Conversation-Id",
                "value": "{{conversationId}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"message\": \"\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/chat",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "chat"]
            }
          },
          "response": [
            {
              "name": "Validation Error",
              "status": "Bad Request",
              "code": 400,
              "header": [
                {
                  "key": "Content-Type",
                  "value": "application/json"
                },
                {
                  "key": "X-Trace-Id",
                  "value": "{{traceId}}"
                }
              ],
              "body": "{\n  \"timestamp\": \"2026-06-21T10:30:00.123Z\",\n  \"status\": 400,\n  \"error\": \"Bad Request\",\n  \"message\": \"Validation failed\",\n  \"path\": \"/api/v1/chat\",\n  \"traceId\": \"{{traceId}}\",\n  \"validationErrors\": [\n    {\n      \"field\": \"message\",\n      \"message\": \"must not be blank\",\n      \"rejectedValue\": \"\"\n    }\n  ]\n}"
            }
          ],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 400\", () => {",
                  "    pm.response.to.have.status(400);",
                  "});",
                  "pm.test(\"Response body exists\", () => {",
                  "    pm.response.to.have.body();",
                  "});",
                  "pm.test(\"X-Trace-Id response header exists\", () => {",
                  "    pm.response.to.have.header(\"X-Trace-Id\");",
                  "});",
                  "pm.test(\"X-Conversation-Id response header exists\", () => {",
                  "    pm.response.to.have.header(\"X-Conversation-Id\");",
                  "});",
                  "pm.test(\"X-Conversation-Id is a valid UUID\", () => {",
                  "    const val = pm.response.headers.get(\"X-Conversation-Id\");",
                  "    pm.expect(val).to.match(/^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i);",
                  "});",
                  "pm.test(\"traceId in JSON body is non-empty\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.traceId).to.not.be.empty;",
                  "});",
                  "pm.test(\"validationErrors contains field-level details\", () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.validationErrors).to.be.an('array');",
                  "    pm.expect(json.validationErrors.length).to.be.at.least(1);",
                  "    pm.expect(json.validationErrors[0]).to.have.property('field');",
                  "    pm.expect(json.validationErrors[0]).to.have.property('message');",
                  "    pm.expect(json.validationErrors[0]).to.have.property('rejectedValue');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ]
        }
